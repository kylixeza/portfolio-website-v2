---
import '../styles/portfolio.css';

// Image URLs depend on the original site's hosting and its images remaining available.
const imageBase = 'https://kylixeza.my.id/images/';
const projectImages = ['soulmath.webp', 'beu.webp', 'dopalearn.webp', 'pondpedia.webp', 'surveyasia.webp', 'firetor.webp', 'nembayu.webp', 'slamet.webp', 'semar.webp'];
const projects = [
  { name: 'SoulMath', type: 'Learning app', href: 'https://play.google.com/store/apps/details?id=com.ramiyon.soulmath_v3&hl=id' },
  { name: 'Beu', type: 'Recipe platform', href: 'https://cookwithbeu.web.id' },
  { name: 'Dopalearn', type: 'Learning app', href: 'https://play.google.com/store/apps/details?id=com.littlebrainboosters.dopalearn', appStore: 'https://apps.apple.com/id/app/dopalearn/id1542507323' },
  { name: 'PondPedia', type: 'Mobile app', href: 'https://play.google.com/store/apps/details?id=com.pondpedia.android.pondpedia' },
  { name: 'SurveyAsia', type: 'Mobile app', href: 'https://play.google.com/store/apps/details?id=com.citiasia.survei_asia' },
  { name: 'Firetor', type: 'Open-source library', href: 'https://github.com/kylixeza/firetor' },
  { name: 'Nembayu', type: 'Mobile app', href: 'https://apps.apple.com/id/app/nembayu/id6444177178' },
  { name: 'Slamet', type: 'Mobile app', href: 'https://play.google.com/store/apps/details?id=id.pammineral.slamet&pcampaignid=web_share', appStore: 'https://apps.apple.com/id/app/slamet/id6670607085' },
  { name: 'Semar', type: 'Mobile app', href: 'https://play.google.com/store/apps/details?id=com.indokordsa.app&pcampaignid=web_share', appStore: 'https://apps.apple.com/id/app/semar/id6446005830' },
];
const experience = [
  { role: 'Lead Mobile Developer', company: 'PT Abhimantra Sistem Solusindo', period: 'May 2026 – Present · Jakarta, full-time', detail: 'Led the mobile development team, established best practices, and mentored team members while aligning technical strategy with business goals.' },
  { role: 'Mobile Developer', company: 'PT Abhimantra Sistem Solusindo', period: 'Oct 2024 – May 2026', detail: 'Built and maintained Android and iOS applications with Flutter and Compose Multiplatform, collaborating across mobile and backend teams.' },
  { role: 'Android Developer', company: 'Little Brain Boosters', period: 'Aug 2023 – Sep 2024 · Part-time, remote', detail: 'Developed Android apps with Kotlin and Firebase; contributed to app performance, Play Console releases, testing, and subscriptions.' },
  { role: 'Mobile Developer Intern', company: 'Citiasia Inc.', period: 'Feb 2023 – Jul 2023 · Jakarta', detail: 'Built Flutter applications for Android and iOS and worked with designers and Scrum teams.' },
];
const awards = [
  '1st Winner, INTENTION (App & Web Dev), IFEST, University of Padjadjaran (2021)',
  '1st Winner, App Innovation HOLOGY 5.0, University of Brawijaya (2022)',
  '9th Place, Varsity Hackathon, Universiti Sains Malaysia (2022)',
  '3rd Place, 8th Closer Hackathon, Telkom University (2022)',
  'Best Graduate, FILKOM UB Yudisium Period XI 2023/2024 (2024)',
  'Best Graduate, University of Brawijaya Graduation Period XII 2024/2025 (2024)',
];
const credentials = [
  { title: 'Associate Android Developer', issuer: 'Google Developers · 2022', href: 'https://www.credential.net/cc14d1ac-f6fb-46d5-8c17-9850b1d304bc' },
  { title: 'SoulMath patent', issuer: 'Ministry of Law and Human Rights, Indonesia · 2023', href: 'https://drive.google.com/file/d/1dPQjRZfaZ3zstNcghVf96l50oKQu8crz/view?usp=sharing' },
  { title: 'Mobile Application for Cuisine Recipe Guide Using Image Classification', issuer: 'J-PTIIK · Journal publication · 2024', href: 'https://j-ptiik.ub.ac.id/index.php/j-ptiik/article/view/13913' },
];
const social = [
  { label: 'GitHub', href: 'https://github.com/kylixeza' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/kylixezasaputra/' },
  { label: 'Email', href: 'mailto:kylixeza.dev@gmail.com' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#f4f1eb" />
    <meta name="description" content="Kylix Eza Saputra | mobile developer building thoughtful Android and cross-platform experiences." />
    <meta property="og:title" content="Kylix Eza Saputra | Mobile Developer" />
    <meta property="og:description" content="Selected work, experience, and writing by Kylix Eza Saputra." />
    <meta property="og:url" content="https://kylixeza.my.id/" />
    <meta property="og:type" content="website" />
    <link rel="canonical" href="https://kylixeza.my.id/" />
    <title>Kylix Eza Saputra | Mobile Developer</title>
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'Person', name: 'Kylix Eza Saputra', url: 'https://kylixeza.my.id/', jobTitle: 'Mobile Developer', sameAs: social.map((item) => item.href).filter((href) => href.startsWith('https://')) })} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="wordmark" href="#top" aria-label="Kylix, home">K<span>.</span></a>
      <nav aria-label="Main navigation">
        <a href="#work">Work</a><a href="#experience">Experience</a><a href="#about">About</a>
      </nav>
      <a class="header-contact" href="mailto:kylixeza.dev@gmail.com">Let’s talk <span aria-hidden="true">↗</span></a>
    </header>
    <main id="main">
      <section class="hero" id="top" aria-labelledby="hero-title">
        <p class="eyebrow">Kylix Eza Saputra / Mobile developer</p>
        <h1 id="hero-title">Ideas into apps.<br /><em>That’s my work.</em></h1>
        <p class="hero-specialty">Android. Flutter.<br />Compose Multiplatform.</p>
        <div class="hero-foot">
          <p>Hey, I’m Kylix. I build for Android and iOS, from native applications to shared codebases. Currently Lead Mobile Developer at PT Abhimantra Sistem Solusindo.</p>
          <a class="text-link" href="#work">See selected work <span aria-hidden="true">↓</span></a>
        </div>
        <div class="hero-index" aria-hidden="true">KYLIX / SELECTED WORK / 2026</div>
      </section>

      <section class="section work-section" id="work" aria-labelledby="work-title">
        <div class="section-heading"><p class="eyebrow">01 / Selected work</p><h2 id="work-title">Made to be <em>used.</em></h2></div>
        <div class="project-grid">
          {projects.map((project, index) => (
            <article class:list={['project-card', { 'project-featured': index < 3, 'project-compact': index >= 3 }]} data-motion={index < 3 ? 'project' : undefined}>
              <span class="project-number" aria-hidden="true">0{index + 1}</span>
              <div class="project-image"><img src={`${imageBase}${projectImages[index]}`} alt={`${project.name} project artwork`} width="960" height="720" loading="lazy" decoding="async" /></div>
              <div class="project-meta"><div><h3>{project.name}</h3><p>{project.type}</p><div class="project-links"><a href={project.href} target="_blank" rel="noreferrer" aria-label={`${project.name}: ${project.href.includes('play.google.com') ? 'Google Play' : project.href.includes('apps.apple.com') ? 'App Store' : project.name === 'Firetor' ? 'GitHub' : 'Website'} (opens in new tab)`}>{project.href.includes('play.google.com') ? 'Google Play' : project.href.includes('apps.apple.com') ? 'App Store' : project.name === 'Firetor' ? 'GitHub' : 'Website'} ↗</a>{project.appStore && <a href={project.appStore} target="_blank" rel="noreferrer" aria-label={`${project.name}: App Store (opens in new tab)`}>App Store ↗</a>}</div></div></div>
            </article>
          ))}
        </div>
      </section>

      <section class="section experience-section" id="experience" aria-labelledby="experience-title">
        <div class="section-heading" data-motion="heading"><p class="eyebrow">02 / Where I’ve worked</p><h2 id="experience-title">Experience, <em>in practice.</em></h2></div>
        <div class="experience-list">
          {experience.map((job) => <article class="experience-item" data-motion="career"><div class="experience-period">{job.period}</div><div><h3>{job.role}</h3><p class="company">{job.company}</p><p>{job.detail}</p></div></article>)}
        </div>
      </section>

      <section class="section about-section" id="about" aria-labelledby="about-title">
        <div class="section-heading"><p class="eyebrow">03 / A little about me</p><h2 id="about-title">Curious by <em>default.</em></h2></div>
        <div class="about-layout"><figure class="about-portrait" data-motion="portrait"><img class="about-photo" src={`${imageBase}about.png`} alt="Kylix Eza Saputra" width="640" height="800" loading="lazy" decoding="async" /><figcaption>Kylix Eza Saputra<br /><span>Mobile developer</span></figcaption></figure><div class="about-copy"><p>I’m a mobile developer who enjoys bringing an idea from a rough sketch to something people can use. My work spans native Android, Flutter, and Compose Multiplatform.</p><p>I earned a Bachelor’s degree in Informatics Engineering from the University of Brawijaya in 2024, graduating with a 3.96 / 4.00 GPA. I’ve also contributed to developer communities and student projects.</p><div class="skill-list" aria-label="Areas of work"><span>Android</span><span>Kotlin</span><span>Compose Multiplatform</span><span>Flutter</span><span>Firebase</span><span>Mobile architecture</span></div></div></div>
      </section>

      <section class="section recognition-section" aria-labelledby="recognition-title">
        <div class="section-heading"><p class="eyebrow">04 / Recognition</p><h2 id="recognition-title">A few <em>milestones.</em></h2></div>
        <ul class="recognition-list">{awards.map((award) => <li>{award}</li>)}</ul>
        <div class="credentials"><h3>Credentials & publication</h3>{credentials.map((item) => <a href={item.href} target="_blank" rel="noreferrer"><span>{item.title}<small>{item.issuer}</small></span><span aria-hidden="true">↗</span></a>)}</div>
      </section>

      <section class="contact-section" id="contact" aria-labelledby="contact-title" data-motion="contact">
        <p class="eyebrow">Have a good one in mind?</p><h2 id="contact-title">Let’s make it<br /><em>matter.</em></h2>
        <a class="contact-link" href="mailto:kylixeza.dev@gmail.com">kylixeza.dev@gmail.com <span aria-hidden="true">↗</span></a>
      </section>
    </main>
    <footer class="site-footer"><span>© {new Date().getFullYear()} Kylix Eza Saputra</span><div>{social.map((item) => <a href={item.href} target={item.href.startsWith('https://') ? '_blank' : undefined} rel={item.href.startsWith('https://') ? 'noreferrer' : undefined}>{item.label}</a>)}</div><a href="#top">Back to top ↑</a></footer>
    <script>
      // Motion is additive: content never waits for JavaScript to become visible.
      const motionPreference = window.matchMedia('(prefers-reduced-motion: no-preference)');
      if ('IntersectionObserver' in window && motionPreference.matches) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              if (motionPreference.matches && !entry.target.contains(document.activeElement)) {
                entry.target.classList.add('motion-enter');
              }
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.12 });

        document.querySelectorAll('[data-motion]').forEach((element) => {
          observer.observe(element);
          element.addEventListener('focusin', () => {
            element.classList.remove('motion-enter');
            observer.unobserve(element);
          }, { once: true });
        });
        motionPreference.addEventListener('change', () => {
          if (!motionPreference.matches) {
            observer.disconnect();
            document.querySelectorAll('.motion-enter').forEach((element) => element.classList.remove('motion-enter'));
          }
        });
      }
    </script>
  </body>
</html>
