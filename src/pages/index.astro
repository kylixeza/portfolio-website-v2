---
import '../styles/portfolio.css';

const imageBase = '/images/';

const projects = [
  { name: 'Slamet', type: 'Mobile app', platform: 'Flutter', year: '2025', client: 'PT PAM Mineral Tbk', image: 'slamet.webp', href: 'https://play.google.com/store/apps/details?id=id.pammineral.slamet&pcampaignid=web_share', appStore: 'https://apps.apple.com/id/app/slamet/id6670607085', note: 'Enterprise safety and accident tracking app across five modules: Hazard Report, Inspection, Accident Management, Behavior-Based Safety, and PICA.' },
  { name: 'Semar', type: 'Mobile app', platform: 'Flutter', year: '2025', client: 'PT Indo Kordsa Tbk', image: 'semar.webp', href: 'https://play.google.com/store/apps/details?id=com.indokordsa.app&pcampaignid=web_share', appStore: 'https://apps.apple.com/id/app/semar/id6446005830', note: 'Enterprise SHE management app across six modules: Safe Your Friend, Equipment Inspection, SHE Inspection, Work Permit, Data Analytics, and SHE Campaign.' },
  { name: 'Nembayu', type: 'Mobile app', platform: 'Flutter', year: '2025', client: 'PT Kideco Jaya Agung', image: 'nembayu.webp', href: 'https://apps.apple.com/id/app/nembayu/id6444177178', note: 'Public safety reporting app across five modules: Hazard Report, Inspection, Incident, Behavior-Based Safety, and PICA.' },
  { name: 'Beu', type: 'Recipe platform', platform: 'Compose Multiplatform', year: '2024', client: 'Independent · J-PTIIK Research', image: 'beu.webp', href: 'https://cookwithbeu.web.id', note: 'Indonesian cuisine recipe guide powered by on-device image classification research (J-PTIIK 2024), built with Compose Multiplatform.' },
  { name: 'Dopalearn', type: 'Learning app', platform: 'Android', year: '2024', client: 'Little Brain Boosters', image: 'dopalearn.webp', href: 'https://play.google.com/store/apps/details?id=com.littlebrainboosters.dopalearn', appStore: 'https://apps.apple.com/id/app/dopalearn/id1542507323', note: 'Kids video-learning app that replaces ads with periodic popup micro-lessons and challenges, letting parents assign math, reading, and vocabulary lessons.' },
  { name: 'Firetor', type: 'Open-source library', platform: 'Library', year: '2024', client: 'Open Source', image: 'firetor.webp', href: 'https://github.com/kylixeza/firetor', note: 'Open-source Kotlin library simplifying Firebase Firestore queries, real-time listeners, and reactive data workflows for Android and KMP.' },
  { name: 'SoulMath', type: 'Learning app', platform: 'Android', year: '2023', client: 'UB Learning Technology', image: 'soulmath.webp', href: 'https://play.google.com/store/apps/details?id=com.ramiyon.soulmath_v3&hl=id', note: 'Interactive math learning Android app designed for students with special needs (ABK Tunagrahita), holding a registered Indonesian IP patent.' },
  { name: 'PondPedia', type: 'Mobile app', platform: 'Android', year: '2023', client: 'PondPedia', image: 'pondpedia.webp', href: 'https://play.google.com/store/apps/details?id=com.pondpedia.android.pondpedia', note: 'Native Android client built for aquaculture operations, helping fish farmers monitor pond conditions and manage daily workflows.' },
  { name: 'SurveyAsia', type: 'Mobile app', platform: 'Flutter', year: '2023', client: 'PT Citiasia Internasional', image: 'surveyasia.webp', href: 'https://play.google.com/store/apps/details?id=com.citiasia.survei_asia', note: 'Cross-platform survey and respondent data-collection app built with Flutter for Android and iOS during an internship at Citiasia Inc.' },
];

const defaultWorkProject = projects.find((p) => p.name === 'SoulMath') ?? projects[0];

const projectLinks = Object.fromEntries(projects.map((p) => [p.name, p.href]));

const experience = [
  { role: 'Lead Mobile Developer', company: 'PT Abhimantra Sistem Solusindo', period: 'May 2026 – Present · Jakarta, full-time', stack: 'Flutter · KMP · Architecture', work: ['Slamet', 'Semar', 'Nembayu'], detail: 'Led the mobile development team, established best practices, and mentored team members while aligning technical strategy with business goals.' },
  { role: 'Mobile Developer', company: 'PT Abhimantra Sistem Solusindo', period: 'Oct 2024 – May 2026', stack: 'Flutter · Compose Multiplatform', work: ['Slamet', 'Semar', 'Nembayu'], detail: 'Built and maintained Android and iOS applications with Flutter and Compose Multiplatform, collaborating across mobile and backend teams.' },
  { role: 'Android Developer', company: 'Little Brain Boosters', period: 'Aug 2023 – Sep 2024 · Part-time, remote', stack: 'Kotlin · Firebase · Play Console', work: ['Dopalearn'], detail: 'Developed Android apps with Kotlin and Firebase; contributed to app performance, Play Console releases, testing, and subscriptions.' },
  { role: 'Mobile Developer Intern', company: 'Citiasia Inc.', period: 'Feb 2023 – Jul 2023 · Jakarta', stack: 'Flutter · Scrum', work: ['SurveyAsia'], detail: 'Built Flutter applications for Android and iOS and worked with designers and Scrum teams.' },
];

const awards = [
  { year: '2021', title: '1st Winner, INTENTION (App & Web Dev), IFEST', org: 'University of Padjadjaran' },
  { year: '2022', title: '1st Winner, App Innovation HOLOGY 5.0', org: 'University of Brawijaya' },
  { year: '2022', title: '9th Place, Varsity Hackathon', org: 'Universiti Sains Malaysia' },
  { year: '2022', title: '3rd Place, 8th Closer Hackathon', org: 'Telkom University' },
  { year: '2024', title: 'Best Graduate, FILKOM UB Yudisium Period XI 2023/2024', org: 'University of Brawijaya' },
  { year: '2024', title: 'Best Graduate, University of Brawijaya Graduation Period XII 2024/2025', org: 'University of Brawijaya' },
];

const credentials = [
  { title: 'Associate Android Developer', issuer: 'Google Developers · 2022', kind: 'Certification', href: 'https://www.credential.net/cc14d1ac-f6fb-46d5-8c17-9850b1d304bc' },
  { title: 'SoulMath patent', issuer: 'Ministry of Law and Human Rights, Indonesia · 2023', kind: 'Intellectual Property', href: 'https://drive.google.com/file/d/1dPQjRZfaZ3zstNcghVf96l50oKQu8crz/view?usp=sharing' },
  { title: 'Mobile Application for Cuisine Recipe Guide Using Image Classification', issuer: 'J-PTIIK · 2024', kind: 'Journal Publication', href: 'https://j-ptiik.ub.ac.id/index.php/j-ptiik/article/view/13913' },
];

const social = [
  { label: 'GitHub', href: 'https://github.com/kylixeza' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/kylixezasaputra/' },
  { label: 'Email', href: 'mailto:kylixeza.dev@gmail.com' },
];

const platforms = ['All', 'Android', 'Flutter', 'Compose Multiplatform', 'Library'];

const techStack = [
  { name: 'Android', area: 'Native OS', href: 'https://developer.android.com', icon: 'https://www.vectorlogo.zone/logos/android/android-icon.svg' },
  { name: 'Kotlin', area: 'Primary language', href: 'https://kotlinlang.org', icon: 'https://www.vectorlogo.zone/logos/kotlinlang/kotlinlang-icon.svg' },
  { name: 'Compose Multiplatform', area: 'Shared UI', href: 'https://www.jetbrains.com/compose-multiplatform/', icon: 'https://raw.githubusercontent.com/gilbarbara/logos/refs/heads/main/logos/compose-multiplatform.svg' },
  { name: 'Flutter', area: 'Cross-platform', href: 'https://flutter.dev', icon: 'https://www.vectorlogo.zone/logos/flutterio/flutterio-icon.svg' },
  { name: 'Firebase', area: 'Cloud & Auth', href: 'https://firebase.google.com/', icon: 'https://www.vectorlogo.zone/logos/firebase/firebase-icon.svg' },
  { name: 'Ktor', area: 'Kotlin backend', href: 'https://ktor.io', icon: 'https://raw.githubusercontent.com/gilbarbara/logos/refs/heads/main/logos/ktor-icon.svg' },
  { name: 'PostgreSQL', area: 'Relational DB', href: 'https://www.postgresql.org', icon: 'https://www.vectorlogo.zone/logos/postgresql/postgresql-icon.svg' },
  { name: 'TensorFlow', area: 'On-device ML', href: 'https://www.tensorflow.org', icon: 'https://www.vectorlogo.zone/logos/tensorflow/tensorflow-icon.svg' },
];

const news = [
  {
    title: 'Terinspirasi Ibu Jualan Soto, Alumnus Top UB Buat Aplikasi Kuliner',
    summary: 'Perjuangan ibu berjualan soto rupanya memberikan inspirasi berkarya bagi Kylix Eza Saputra.',
    date: 'Dec 23, 2024',
    source: 'detikEdu',
    image: 'news_4.webp',
    href: 'https://www.detik.com/edu/edutainment/d-7700021/terinspirasi-ibu-jualan-soto-alumnus-top-ub-ini-buat-aplikasi-kuliner-nusantara',
  },
  {
    title: 'FILKOM Buat Aplikasi Pembelajaran ABK Tunagrahita',
    summary: 'Aplikasi pembelajaran SoulMath yang dikembangkan khusus untuk membantu siswa ABK Tunagrahita.',
    date: 'Nov 06, 2023',
    source: 'Prasetya UB',
    image: 'news_3.webp',
    href: 'https://prasetya.ub.ac.id/filkom-ub-hasilkan-aplikasi-untuk-pembelajaran-anak-berkebutuhan-khusus-abk-tunagrahita-di-smkn-2-malang/',
  },
  {
    title: 'Kenalkan Google Solution Challenge Pada Mahasiswa',
    summary: 'GDSC mengundang Kylix Eza Saputra selaku Curriculum Lead GDSC UB.',
    date: 'Jan 30, 2023',
    source: 'Prasetya UB',
    image: 'news_2.webp',
    href: 'https://prasetya.ub.ac.id/kenalkan-google-solution-challenge-pada-mahasiswa-filkom-gdsc-ub-selenggarakan-info-session/',
  },
  {
    title: 'GDSC UB 2021: The Threshold of a New Age',
    summary: 'TechSeries Workshop talking about KOTLIN 101 with Android Learning Development, Kylix Eza Saputra.',
    date: 'Nov 17, 2021',
    source: 'GDSC UB',
    image: 'news_1.webp',
    href: 'https://medium.com/developer-student-club-universitas-brawijaya/gdsc-ub-2021-the-threshold-of-a-new-age-154496f6916e',
  },
];

const stageImages = [
  { id: 'hero', src: `${imageBase}about.png`, alt: 'Kylix Eza Saputra portrait', caption: 'Kylix Eza Saputra · Lead Mobile Developer' },
  { id: 'work', src: `${imageBase}soulmath.webp`, alt: 'SoulMath mobile learning application artwork', caption: 'Selected shipped work · SoulMath' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ebe5e3" />
    <meta name="description" content="Kylix Eza Saputra | Lead Mobile Developer building Android, Flutter, and Compose Multiplatform experiences." />
    <meta property="og:title" content="Kylix Eza Saputra | Mobile Developer" />
    <meta property="og:description" content="Selected work, experience, and CV by Kylix Eza Saputra." />
    <meta property="og:url" content="https://kylixeza.my.id/" />
    <meta property="og:type" content="website" />
    <link rel="canonical" href="https://kylixeza.my.id/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/webp" href="/images/favicon.webp" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="preconnect" href="https://api.fontshare.com" />
    <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
    <link href="https://api.fontshare.com/v2/css?f[]=switzer@400,500&display=swap" rel="stylesheet" />
    <title>Kylix Eza Saputra | Mobile Developer</title>
    <script is:inline>document.documentElement.classList.add('js');</script>
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'Person', name: 'Kylix Eza Saputra', url: 'https://kylixeza.my.id/', jobTitle: 'Lead Mobile Developer', sameAs: social.map((item) => item.href).filter((href) => href.startsWith('https://')) })} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header wrap">
      <a class="wordmark" href="#top" aria-label="Kylix Eza Saputra, home">Kylix</a>
      <nav aria-label="Main navigation">
        <a class="link" href="#work">Work</a>
        <a class="link" href="#experience">Experience</a>
        <a class="link" href="#about">About</a>
        <a class="link" href="#stack">Stack</a>
        <a class="link" href="#news">News</a>
        <a class="link" href="#contact">Contact</a>
      </nav>
      <a class="button header-cv" href="/docs/cv.pdf" download="Kylix-Eza-Saputra-CV.pdf">Download CV</a>
    </header>

    <main id="main">
      <div class="split-shell wrap" id="top">
        <aside class="stage-column" aria-label="Visual preview stage">
          <div class="stage-frame" data-open data-stage-chapter="hero">
            <span class="stage-glow" aria-hidden="true"></span>
            {stageImages.map((item, index) => (
              <img
                src={item.src}
                alt={item.alt}
                width="960"
                height="1200"
                class:list={['stage-img', { 'is-active': index === 0, 'is-banner': item.id !== 'hero' }]}
                data-stage-id={item.id}
                fetchpriority={index === 0 ? 'high' : undefined}
                loading={index === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />
            ))}
            <div class="stage-card stage-card--experience" data-stage-id="experience">
              <div class="stage-card-top">
                <span class="stage-eyebrow small muted">Career snapshot</span>
                <p class="stage-card-title" id="exp-stage-role">{experience[0].role}</p>
                <p class="small muted" id="exp-stage-company">{experience[0].company}</p>
                <p class="small stage-card-period nums" id="exp-stage-period">{experience[0].period}</p>
              </div>
              <div class="stage-metrics">
                <div class="stage-metric">
                  <span class="stage-metric-val nums">3+ yrs</span>
                  <span class="small muted">Mobile shipping</span>
                </div>
                <div class="stage-metric">
                  <span class="stage-metric-val nums">8+</span>
                  <span class="small muted">Store releases</span>
                </div>
                <div class="stage-metric">
                  <span class="stage-metric-val nums">3</span>
                  <span class="small muted">Platforms</span>
                </div>
              </div>
              <div class="stage-card-foot">
                <span class="small muted">Focus</span>
                <p class="stage-card-stack" id="exp-stage-stack">{experience[0].stack}</p>
                <span class="small muted stage-card-sublabel">Related work</span>
                <p class="stage-card-work" id="exp-stage-work">
                  {experience[0].work.map((name, i) => (
                    <>
                      {i > 0 && <span class="muted"> · </span>}
                      <a class="link" href={projectLinks[name]} target="_blank" rel="noreferrer">{name}</a>
                    </>
                  ))}
                </p>
              </div>
            </div>
            <img
              src={`${imageBase}soulmath.webp`}
              alt=""
              width="1200"
              height="750"
              class="stage-img stage-hover-img is-banner"
              id="stage-hover-img-a"
              aria-hidden="true"
            />
            <img
              src={`${imageBase}soulmath.webp`}
              alt=""
              width="1200"
              height="750"
              class="stage-img stage-hover-img is-banner"
              id="stage-hover-img-b"
              aria-hidden="true"
            />
            <div class="stage-work-panel" id="stage-work-panel" aria-live="polite">
              <div class="stage-work-meta">
                <span class="stage-eyebrow small muted" id="work-stage-meta">{defaultWorkProject.platform} · {defaultWorkProject.year}</span>
                <span class="small muted" id="work-stage-type">{defaultWorkProject.type}</span>
              </div>
              <p class="stage-work-title" id="work-stage-title">{defaultWorkProject.name}</p>
              <p class="stage-work-desc muted" id="work-stage-desc">{defaultWorkProject.note}</p>
              <div class="stage-work-client">
                <span class="stage-eyebrow small muted">Company / Client</span>
                <span class="small stage-work-client-val" id="work-stage-client">{defaultWorkProject.client}</span>
              </div>
            </div>
          </div>
        </aside>

        <div class="reading-column">
          <section class="hero-block" aria-labelledby="hero-title" data-chapter="hero">
            <h1 class="display lines" id="hero-title">
              <span class="line"><span data-line style="--i:0">Kylix Eza Saputra</span></span>
              <span class="line"><span data-line style="--i:1">Mobile developer</span></span>
            </h1>
            <p class="lead" data-load style="--d:320ms">
              Lead Mobile Developer building Android, Flutter, and Compose Multiplatform applications from Jakarta.
            </p>
            <div class="hero-actions" data-load style="--d:440ms">
              <a class="button" href="/docs/cv.pdf" download="Kylix-Eza-Saputra-CV.pdf">Download CV</a>
              <a class="link" href="#work">Selected work</a>
            </div>
          </section>

          <section class="section-block work-block" id="work" aria-labelledby="work-title" data-chapter="work">
            <div class="section-head" data-reveal>
              <h2 class="head" id="work-title">Selected work</h2>
              <p class="muted">Hover or select a platform to inspect shipped apps on the stage.</p>
            </div>

            <div class="filter-bar" role="group" aria-label="Filter projects by platform" data-reveal>
              <span class="filter-indicator" aria-hidden="true"></span>
              {platforms.map((platform) => (
                <button
                  type="button"
                  class:list={['filter-btn', { 'is-active': platform === 'All' }]}
                  data-filter={platform}
                  aria-pressed={platform === 'All' ? 'true' : 'false'}
                >
                  {platform}
                </button>
              ))}
            </div>

            <ul class="ledger-list" id="project-ledger">
              {projects.map((project, index) => (
                <li
                  class="ledger-item"
                  data-platform={project.platform}
                  data-name={project.name}
                  data-type={project.type}
                  data-year={project.year}
                  data-client={project.client}
                  data-note={project.note}
                  data-preview={`${imageBase}${project.image}`}
                  data-caption={`${project.name} · ${project.type}`}
                  data-reveal
                  style={`--stagger: ${index}`}
                >
                  <div class="ledger-row">
                    {index < 3 && (
                      <div class="ledger-mobile-thumb">
                        <img
                          src={`${imageBase}${project.image}`}
                          alt={`${project.name} preview`}
                          width="960"
                          height="600"
                          loading="lazy"
                          decoding="async"
                        />
                      </div>
                    )}
                    <div class="ledger-main">
                      <a
                        class="ledger-title link"
                        href={project.href}
                        target="_blank"
                        rel="noreferrer"
                        data-preview-trigger
                      >
                        {project.name}
                      </a>
                      <span class="ledger-type muted">{project.type}</span>
                      <span class="ledger-year nums">{project.year}</span>
                    </div>
                    <div class="ledger-links small">
                      <a
                        class="link"
                        href={project.href}
                        target="_blank"
                        rel="noreferrer"
                      >
                        {project.href.includes('play.google.com')
                          ? 'Google Play'
                          : project.href.includes('apps.apple.com')
                            ? 'App Store'
                            : project.name === 'Firetor'
                              ? 'GitHub'
                              : 'Website'}
                      </a>
                      {project.appStore && (
                        <a class="link" href={project.appStore} target="_blank" rel="noreferrer">
                          App Store
                        </a>
                      )}
                    </div>
                  </div>
                </li>
              ))}
            </ul>
            <p class="small muted empty-state" id="ledger-empty" hidden>
              No shipped projects match that platform filter.
            </p>
          </section>

          <section class="section-block experience-block" id="experience" aria-labelledby="experience-title" data-chapter="experience">
            <div class="section-head" data-reveal>
              <h2 class="head" id="experience-title">Experience</h2>
            </div>

            <div class="timeline-list">
              {experience.map((job, idx) => (
                <article
                  class:list={['timeline-item', { 'is-current': idx === 0 }]}
                  data-reveal
                  data-exp-role={job.role}
                  data-exp-company={job.company}
                  data-exp-period={job.period}
                  data-exp-stack={job.stack}
                  data-exp-work={JSON.stringify(job.work.map((name) => ({ name, href: projectLinks[name] })))}
                >
                  <p class="small muted nums timeline-period">{job.period}</p>
                  <div class="timeline-body">
                    <h3 class="timeline-role">{job.role}</h3>
                    <p class="timeline-company">{job.company}</p>
                    <p class="timeline-detail">{job.detail}</p>
                  </div>
                </article>
              ))}
            </div>
          </section>
        </div>
      </div>

      <section class="full-band about-band wrap" id="about" aria-labelledby="about-title" data-droplet>
        <div class="droplet-stage" aria-hidden="true">
          <span class="droplet-drop"></span>
          <span class="droplet-ripple droplet-ripple--1"></span>
          <span class="droplet-ripple droplet-ripple--2"></span>
        </div>

        <div class="namecard-scene">
          <div
            class="namecard-flipper"
            id="about-namecard"
            role="button"
            tabindex="0"
            aria-pressed="false"
            aria-label="Flip virtual name card"
          >
            <div class="letter-card namecard-face namecard-face--front" data-flip-surface>
              <div class="letter-aside">
                <div class="letter-author">
                  <img
                    src={`${imageBase}about.png`}
                    alt="Kylix Eza Saputra"
                    width="88"
                    height="88"
                    loading="lazy"
                    decoding="async"
                  />
                  <div>
                    <h2 class="head" id="about-title">About</h2>
                    <p class="small muted">Virtual name card · Click to flip</p>
                  </div>
                </div>

                <div class="letter-signoff">
                  <p class="signoff-name">Kylix Eza Saputra</p>
                  <p class="small muted">Lead Mobile Developer · Jakarta, Indonesia</p>
                </div>
              </div>

              <div class="letter-main">
                <div class="letter-copy">
                  <p>
                    Kylix is an enthusiastic, disciplined, and hardworking individual. He possesses good communication, teamwork, and leadership skills.
                  </p>
                  <p>
                    He has a passion for mobile application development, especially in the Kotlin ecosystem such as Native Android and Compose Multiplatform.
                  </p>
                  <p>
                    He also has extensive experience as an Android Engineer in various projects, where he has been responsible for building solid and reliable Android applications with high-quality software. His clients come from both Indonesia and abroad.
                  </p>
                </div>

                <div class="stack-row" aria-label="Core technologies">
                  <span>Android</span>
                  <span>Kotlin</span>
                  <span>Compose Multiplatform</span>
                  <span>Flutter</span>
                  <span>Firebase</span>
                  <span>Mobile architecture</span>
                </div>
              </div>
            </div>

            <div class="letter-card namecard-face namecard-face--back" data-flip-surface aria-hidden="true">
              <div class="letter-aside">
                <div class="namecard-back-id">
                  <span class="stage-eyebrow small muted">Virtual Name Card</span>
                  <p class="namecard-back-name">Kylix Eza Saputra</p>
                  <p class="muted">Lead Mobile Developer</p>
                </div>

                <div class="namecard-back-edu">
                  <span class="stage-eyebrow small muted">Education</span>
                  <p>Bachelor of Informatics Engineering</p>
                  <p class="small muted">University of Brawijaya · 2024 · GPA 3.96 / 4.00</p>
                </div>
              </div>

              <div class="letter-main">
                <div class="namecard-back-grid">
                  <div class="namecard-back-item">
                    <span class="stage-eyebrow small muted">Email</span>
                    <a class="link" href="mailto:kylixeza.dev@gmail.com">kylixeza.dev@gmail.com</a>
                  </div>
                  <div class="namecard-back-item">
                    <span class="stage-eyebrow small muted">Location</span>
                    <span>Jakarta, Indonesia</span>
                  </div>
                  <div class="namecard-back-item">
                    <span class="stage-eyebrow small muted">Links</span>
                    <div class="namecard-back-links">
                      {social.filter((s) => s.href.startsWith('https://')).map((item) => (
                        <a class="link" href={item.href} target="_blank" rel="noreferrer">{item.label}</a>
                      ))}
                      <a class="link" href="/docs/cv.pdf" download="Kylix-Eza-Saputra-CV.pdf">Download CV</a>
                    </div>
                  </div>
                </div>

                <span class="small muted">kylixeza.my.id</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="full-band stack-band wrap" id="stack" aria-labelledby="stack-title">
        <div class="band-stack-header" data-reveal>
          <h2 class="head" id="stack-title">Tech stack</h2>
          <p class="muted">Technologies I work with daily.</p>
        </div>

        <ul class="stack-grid" data-reveal>
          {techStack.map((tech) => (
            <li>
              <a class="stack-tile" href={tech.href} target="_blank" rel="noreferrer">
                <div class="stack-tile-icon">
                  <img src={tech.icon} alt="" width="28" height="28" loading="lazy" decoding="async" />
                </div>
                <div class="stack-tile-meta">
                  <span class="stack-tile-name">{tech.name}</span>
                  <span class="small muted">{tech.area}</span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section class="full-band proof-band wrap" id="recognition" aria-labelledby="proof-title">
        <div class="band-stack-header" data-reveal>
          <h2 class="head" id="proof-title">Recognition</h2>
          <p class="muted">Selected awards, patents, certifications, and research.</p>
        </div>

        <div class="proof-bento" data-reveal>
          <div class="proof-panel">
            <p class="proof-kind muted">Competitions and honours</p>
            <ul class="award-ledger">
              {awards.map((award) => (
                <li class="award-row">
                  <span class="award-year small nums">{award.year}</span>
                  <div class="award-info">
                    <span class="award-title">{award.title}</span>
                    <span class="small muted">{award.org}</span>
                  </div>
                </li>
              ))}
            </ul>
          </div>

          <div class="proof-panel">
            <p class="proof-kind muted">Credentials and publication</p>
            <div class="credential-cards">
              {credentials.map((item) => (
                <a class="credential-card" href={item.href} target="_blank" rel="noreferrer">
                  <div class="credential-top">
                    <span class="credential-kind small muted">{item.kind}</span>
                    <span class="credential-arrow" aria-hidden="true">↗</span>
                  </div>
                  <p class="credential-title">{item.title}</p>
                  <span class="small muted">{item.issuer}</span>
                </a>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section class="full-band news-band wrap" id="news" aria-labelledby="news-title">
        <div class="band-stack-header" data-reveal>
          <h2 class="head" id="news-title">In the news</h2>
          <p class="muted">Workshops, research, and press coverage.</p>
        </div>

        <div class="news-editorial" data-reveal>
          <a class="news-featured" href={news[0].href} target="_blank" rel="noreferrer">
            <div class="news-featured-media">
              <img
                src={`${imageBase}${news[0].image}`}
                alt={news[0].title}
                width="960"
                height="600"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="news-featured-body">
              <div class="news-meta small muted">
                <span>{news[0].source}</span>
                <span aria-hidden="true">·</span>
                <span class="nums">{news[0].date}</span>
              </div>
              <h3 class="news-featured-title">{news[0].title}</h3>
              <p class="muted">{news[0].summary}</p>
              <span class="news-read small">Read article ↗</span>
            </div>
          </a>

          <div class="news-feed">
            {news.slice(1).map((item) => (
              <a class="news-compact" href={item.href} target="_blank" rel="noreferrer">
                <div class="news-compact-media">
                  <img
                    src={`${imageBase}${item.image}`}
                    alt={item.title}
                    width="320"
                    height="220"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div class="news-compact-body">
                  <div class="news-meta small muted">
                    <span>{item.source}</span>
                    <span aria-hidden="true">·</span>
                    <span class="nums">{item.date}</span>
                  </div>
                  <h3 class="news-title">{item.title}</h3>
                  <p class="small muted news-compact-summary">{item.summary}</p>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>

      <section class="full-band contact-band wrap" id="contact" aria-labelledby="contact-title">
        <div class="contact-layout" data-reveal>
          <div class="contact-intro">
            <h2 class="head" id="contact-title">Start a conversation</h2>
            <p class="contact-sub">Send a short note about a mobile role, product build, or collaboration.</p>
          </div>

          <form class="contact-form" id="contact-form" novalidate>
            <label class="sr-only" for="contact-message">Your message</label>
            <div class="contact-field-wrap">
              <input
                class="contact-input"
                id="contact-message"
                name="message"
                type="text"
                placeholder="Write a brief message or project note…"
                required
              />
              <button class="contact-submit" type="submit" aria-label="Open email draft with your message">Send</button>
            </div>
            <p class="small muted" id="contact-feedback" aria-live="polite">
              Opens your email app addressed to kylixeza.dev@gmail.com.
            </p>
            <div class="contact-direct">
              <a class="link" href="mailto:kylixeza.dev@gmail.com">kylixeza.dev@gmail.com</a>
              <a class="link" href="/docs/cv.pdf" download="Kylix-Eza-Saputra-CV.pdf">Download CV (PDF)</a>
            </div>
          </form>
        </div>
      </section>
    </main>

    <footer class="site-footer wrap">

      <div class="footer-top">
        <nav class="footer-links" aria-label="Social links">
          {social.map((item) => (
            <a
              class="link"
              href={item.href}
              target={item.href.startsWith('https://') ? '_blank' : undefined}
              rel={item.href.startsWith('https://') ? 'noreferrer' : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>
        <div class="footer-contact">
          <a class="link" href="mailto:kylixeza.dev@gmail.com">kylixeza.dev@gmail.com</a>
          <a class="link" href="/docs/cv.pdf" target="_blank" rel="noreferrer">Resume / CV</a>
        </div>
      </div>

      <div class="footer-bottom">
        <p class="footer-wordmark" aria-hidden="true">Kylix Eza Saputra</p>
        <div class="footer-legal small">
          <span>© {new Date().getFullYear()} Kylix Eza Saputra</span>
        </div>
      </div>
    </footer>

    <script>
      (() => {
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // 1. Section reveal observer
        const revealEls = document.querySelectorAll('[data-reveal]');
        if ('IntersectionObserver' in window && !reduced) {
          const revealObserver = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (!entry.isIntersecting) continue;
                entry.target.classList.add('is-in');
                revealObserver.unobserve(entry.target);
              }
            },
            { rootMargin: '0px 0px -10% 0px', threshold: 0.08 }
          );
          revealEls.forEach((el) => revealObserver.observe(el));
          window.addEventListener('load', () => {
            setTimeout(() => {
              revealEls.forEach((el) => el.classList.add('is-in'));
            }, 1800);
          });
        } else {
          revealEls.forEach((el) => el.classList.add('is-in'));
        }

        // 1b. Water droplet scroll-into-view animation for About section
        const dropletEls = document.querySelectorAll('[data-droplet]');
        if ('IntersectionObserver' in window && !reduced) {
          const dropletObserver = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (!entry.isIntersecting) continue;
                entry.target.classList.add('is-droplet-in');
                dropletObserver.unobserve(entry.target);
              }
            },
            { rootMargin: '0px 0px -12% 0px', threshold: 0.18 }
          );
          dropletEls.forEach((el) => dropletObserver.observe(el));
        } else {
          dropletEls.forEach((el) => el.classList.add('is-droplet-in'));
        }

        // 1c. Virtual name card horizontal 3D flip
        const namecard = document.getElementById('about-namecard');
        if (namecard) {
          const frontFace = namecard.querySelector('.namecard-face--front');
          const backFace = namecard.querySelector('.namecard-face--back');
          const toggleFlip = () => {
            const flipped = namecard.classList.toggle('is-flipped');
            namecard.setAttribute('aria-pressed', flipped ? 'true' : 'false');
            frontFace?.setAttribute('aria-hidden', flipped ? 'true' : 'false');
            backFace?.setAttribute('aria-hidden', flipped ? 'false' : 'true');
          };
          namecard.addEventListener('click', (e) => {
            const target = e.target instanceof Element ? e.target : null;
            if (!target || target.closest('a')) return;
            if (target.closest('[data-flip-surface]')) toggleFlip();
          });
          namecard.addEventListener('keydown', (e) => {
            if (e.target !== namecard) return;
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              toggleFlip();
            }
          });
        }

        // 2. Smooth morphing & crossfade on sticky stage as chapters scroll into view
        const stageColumn = document.querySelector('.stage-column');
        const stageFrame = document.querySelector('.stage-frame');
        const stageEls = [...document.querySelectorAll('[data-stage-id]')];
        const hoverLayers = [
          document.getElementById('stage-hover-img-a'),
          document.getElementById('stage-hover-img-b'),
        ].filter(Boolean);
        let activeHoverIdx = -1;
        let previewToken = 0;
        let activeChapter = 'hero';

        const workPanel = document.getElementById('stage-work-panel');
        const workMetaEl = document.getElementById('work-stage-meta');
        const workTypeEl = document.getElementById('work-stage-type');
        const workTitleEl = document.getElementById('work-stage-title');
        const workDescEl = document.getElementById('work-stage-desc');
        const workClientEl = document.getElementById('work-stage-client');
        const defaultWorkMeta = workMetaEl?.textContent || '';
        const defaultWorkType = workTypeEl?.textContent || '';
        const defaultWorkTitle = workTitleEl?.textContent || '';
        const defaultWorkDesc = workDescEl?.textContent || '';
        const defaultWorkClient = workClientEl?.textContent || '';

        const syncStageHeight = () => {
          if (!stageFrame || !stageColumn) return;
          const isHovering = activeHoverIdx !== -1;
          const landscape = isHovering || activeChapter === 'work';
          stageFrame.classList.toggle('is-landscape', landscape);
          const panelH = landscape && workPanel ? workPanel.offsetHeight : 0;
          stageFrame.style.setProperty('--work-panel-h', `${panelH}px`);
          if (window.innerWidth <= 900) {
            const baseH = window.innerHeight * 0.46;
            const targetH = landscape ? Math.min(window.innerHeight * 0.65, stageFrame.clientWidth * 0.625 + panelH) : baseH;
            stageFrame.style.height = `${Math.round(targetH)}px`;
            return;
          }
          const colH = stageColumn.clientHeight;
          const colW = stageColumn.clientWidth;
          if (!colH || !colW) return;
          const targetH = landscape ? Math.min(colH, colW * 0.625 + panelH) : colH;
          stageFrame.style.height = `${Math.round(targetH)}px`;
        };

        const setStage = (id) => {
          activeChapter = id;
          stageFrame?.setAttribute('data-stage-chapter', id);
          stageEls.forEach((el) => el.classList.toggle('is-active', el.dataset.stageId === id));
          syncStageHeight();
        };

        syncStageHeight();
        window.addEventListener('resize', syncStageHeight, { passive: true });

        if ('IntersectionObserver' in window) {
          const chapterObserver = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting) {
                  const id = entry.target.getAttribute('data-chapter');
                  if (id) setStage(id);
                }
              }
            },
            { rootMargin: '-35% 0px -45% 0px', threshold: 0 }
          );
          document.querySelectorAll('[data-chapter]').forEach((sec) => chapterObserver.observe(sec));
        }

        // 3. Work ledger platform filter + double-buffered stage preview + liquid glass lens
        const filterBar = document.querySelector('.filter-bar');
        const filterIndicator = filterBar?.querySelector('.filter-indicator');
        const filterBtns = [...document.querySelectorAll('.filter-btn')];
        const ledgerItems = [...document.querySelectorAll('.ledger-item')];
        const emptyState = document.getElementById('ledger-empty');

        const moveIndicator = (btn, animate = true) => {
          if (!filterBar || !filterIndicator || !btn) return;
          if (!animate) filterIndicator.style.transition = 'none';
          filterIndicator.style.width = `${btn.offsetWidth}px`;
          filterIndicator.style.height = `${btn.offsetHeight}px`;
          filterIndicator.style.transform = `translate3d(${btn.offsetLeft}px, ${btn.offsetTop}px, 0)`;
          filterIndicator.classList.add('is-ready');
          if (!animate) {
            filterIndicator.getBoundingClientRect();
            filterIndicator.style.transition = '';
          } else if (!reduced) {
            filterIndicator.classList.remove('is-gliding');
            filterIndicator.getBoundingClientRect();
            filterIndicator.classList.add('is-gliding');
          }
        };

        const initialActive = filterBtns.find((b) => b.classList.contains('is-active')) || filterBtns[0];
        if (initialActive) {
          requestAnimationFrame(() => moveIndicator(initialActive, false));
          document.fonts?.ready.then(() => {
            const current = filterBtns.find((b) => b.classList.contains('is-active'));
            if (current) moveIndicator(current, false);
          });
          window.addEventListener('resize', () => {
            const current = filterBtns.find((b) => b.classList.contains('is-active'));
            if (current) moveIndicator(current, false);
          });
        }

        filterBtns.forEach((btn) => {
          btn.addEventListener('click', () => {
            const filter = btn.dataset.filter || 'All';
            filterBtns.forEach((b) => {
              const active = b === btn;
              b.classList.toggle('is-active', active);
              b.setAttribute('aria-pressed', active ? 'true' : 'false');
            });
            moveIndicator(btn, true);
            let visibleCount = 0;
            ledgerItems.forEach((item) => {
              const match = filter === 'All' || item.dataset.platform === filter;
              item.hidden = !match;
              if (match) visibleCount += 1;
            });
            if (emptyState) emptyState.hidden = visibleCount > 0;
          });
        });

        const preloadPreviews = () => {
          ledgerItems.forEach((item) => {
            const src = item.dataset.preview;
            if (!src) return;
            const img = new Image();
            img.src = src;
          });
        };
        if ('requestIdleCallback' in window) {
          window.requestIdleCallback(preloadPreviews, { timeout: 2500 });
        } else {
          window.addEventListener('load', preloadPreviews, { once: true });
        }

        const updateWorkPanel = (meta, type, title, desc, client) => {
          if (workMetaEl) workMetaEl.textContent = meta;
          if (workTypeEl) workTypeEl.textContent = type;
          if (workTitleEl) workTitleEl.textContent = title;
          if (workDescEl) workDescEl.textContent = desc;
          if (workClientEl) workClientEl.textContent = client;
        };

        const showPreview = (item) => {
          if (hoverLayers.length < 2) return;
          const src = item.dataset.preview;
          const cap = item.dataset.caption;
          if (!src) return;
          const token = ++previewToken;
          const nextIdx = activeHoverIdx === 0 ? 1 : 0;
          const nextEl = hoverLayers[nextIdx];
          const prevEl = activeHoverIdx !== -1 ? hoverLayers[activeHoverIdx] : null;

          updateWorkPanel(
            `${item.dataset.platform || ''} · ${item.dataset.year || ''}`,
            item.dataset.type || '',
            item.dataset.name || '',
            item.dataset.note || '',
            item.dataset.client || ''
          );

          const activate = () => {
            if (token !== previewToken) return;
            nextEl.alt = cap || 'Project preview';
            nextEl.style.zIndex = '3';
            if (prevEl) prevEl.style.zIndex = '2';
            nextEl.classList.add('is-visible');
            if (prevEl && prevEl !== nextEl) prevEl.classList.remove('is-visible');
            activeHoverIdx = nextIdx;
            syncStageHeight();
          };

          if (nextEl.getAttribute('src') === src && nextEl.complete) {
            activate();
            return;
          }
          nextEl.src = src;
          if (typeof nextEl.decode === 'function') {
            nextEl.decode().then(activate, activate);
          } else {
            activate();
          }
        };

        const hidePreview = () => {
          previewToken += 1;
          activeHoverIdx = -1;
          hoverLayers.forEach((el) => el.classList.remove('is-visible'));
          updateWorkPanel(defaultWorkMeta, defaultWorkType, defaultWorkTitle, defaultWorkDesc, defaultWorkClient);
          syncStageHeight();
        };

        ledgerItems.forEach((item) => {
          item.addEventListener('pointerenter', () => showPreview(item));
          item.addEventListener('focusin', () => showPreview(item));
          item.addEventListener('pointerleave', hidePreview);
          item.addEventListener('focusout', (e) => {
            if (!item.contains(e.relatedTarget)) hidePreview();
          });
        });

        // 3b. Experience timeline hover updates stage card with smooth crossfade
        const expCard = document.querySelector('.stage-card--experience');
        const expRoleEl = document.getElementById('exp-stage-role');
        const expCompanyEl = document.getElementById('exp-stage-company');
        const expPeriodEl = document.getElementById('exp-stage-period');
        const expStackEl = document.getElementById('exp-stage-stack');
        const expWorkEl = document.getElementById('exp-stage-work');
        let expSwapTimer = 0;

        document.querySelectorAll('.timeline-item[data-exp-role]').forEach((item) => {
          const updateExpStage = () => {
            const nextRole = item.dataset.expRole || '';
            const nextCompany = item.dataset.expCompany || '';
            const nextPeriod = item.dataset.expPeriod || '';
            const nextStack = item.dataset.expStack || '';
            const nextWork = JSON.parse(item.dataset.expWork || '[]');
            if (
              expRoleEl?.textContent === nextRole &&
              expPeriodEl?.textContent === nextPeriod
            ) return;

            const applyText = () => {
              if (expRoleEl) expRoleEl.textContent = nextRole;
              if (expCompanyEl) expCompanyEl.textContent = nextCompany;
              if (expPeriodEl) expPeriodEl.textContent = nextPeriod;
              if (expStackEl) expStackEl.textContent = nextStack;
              if (expWorkEl) {
                expWorkEl.replaceChildren();
                nextWork.forEach((w, i) => {
                  if (i > 0) {
                    const sep = document.createElement('span');
                    sep.className = 'muted';
                    sep.textContent = ' · ';
                    expWorkEl.appendChild(sep);
                  }
                  const a = document.createElement('a');
                  a.className = 'link';
                  a.href = w.href;
                  a.target = '_blank';
                  a.rel = 'noreferrer';
                  a.textContent = w.name;
                  expWorkEl.appendChild(a);
                });
              }
            };

            if (!expCard || reduced) {
              applyText();
              return;
            }
            window.clearTimeout(expSwapTimer);
            expCard.classList.add('is-updating');
            expSwapTimer = window.setTimeout(() => {
              applyText();
              expCard.classList.remove('is-updating');
            }, 130);
          };
          item.addEventListener('pointerenter', updateExpStage);
          item.addEventListener('focusin', updateExpStage);
        });

        // 4. Single-field contact form handoff
        const form = document.getElementById('contact-form');
        const input = document.getElementById('contact-message');
        const feedback = document.getElementById('contact-feedback');
        form?.addEventListener('submit', (e) => {
          e.preventDefault();
          const val = (input?.value || '').trim();
          if (!val) {
            if (feedback) feedback.textContent = 'Please enter a short note before sending.';
            input?.focus();
            return;
          }
          const subject = encodeURIComponent('Portfolio inquiry for Kylix Eza Saputra');
          const body = encodeURIComponent(val);
          if (feedback) feedback.textContent = 'Opening email draft to kylixeza.dev@gmail.com…';
          window.location.href = `mailto:kylixeza.dev@gmail.com?subject=${subject}&body=${body}`;
        });
      })();
    </script>
  </body>
</html>
